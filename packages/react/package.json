{
  "name": "@pollium/readable-react",
  "version": "0.0.0",
  "description": "The web side of Readable: calls, queries, pages, session, live data and forms typed by the contracts.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pollium/Readable.git",
    "directory": "packages/react"
  },
  "files": [
    "dist",
    "tsconfig.app.json",
    "AGENTS.md"
  ],
  "exports": {
    "./tsconfig.json": "./tsconfig.app.json",
    "./pages/routes": "./lib/pages/routes.tsx",
    "./states/QueryState": "./lib/states/QueryState.tsx",
    "./*": "./lib/*.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      "./tsconfig.json": "./tsconfig.app.json",
      "./*": {
        "types": "./dist/*.d.ts",
        "default": "./dist/*.js"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "lint": "oxlint --deny-warnings",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@pollium/readable-contracts": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "happy-dom": "^20.11.1",
    "oxlint": "^1.71.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "typescript": "~6.0.2",
    "vitest": "^4.1.10"
  }
}
