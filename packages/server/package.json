{
  "name": "@pollium/readable",
  "version": "0.0.0",
  "description": "The TypeScript framework for the AI era.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pollium/Readable.git",
    "directory": "packages/server"
  },
  "files": [
    "dist",
    "tsconfig.app.json",
    "AGENTS.md"
  ],
  "exports": {
    "./tsconfig.json": "./tsconfig.app.json",
    "./*": "./lib/*.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      "./tsconfig.json": "./tsconfig.app.json",
      "./*": {
        "types": "./dist/*.d.ts",
        "default": "./dist/*.js"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "lint": "oxlint --deny-warnings",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1089.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/websocket": "11.3.0",
    "@pollium/readable-contracts": "workspace:*",
    "@typia/unplugin": "^12.1.1",
    "bullmq": "^5.80.6",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "pino": "^10.3.1",
    "typia": "^12.1.1",
    "uuid": "^14.0.2"
  },
  "peerDependencies": {
    "fastify": "^5.12.5",
    "pg": "^8.22.0",
    "typeorm": "^1.1.0",
    "vitest": "^4.1.10"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.1",
    "@types/ws": "^8.18.2",
    "better-sqlite3": "12.11.1",
    "fastify": "^5.12.5",
    "oxlint": "^1.71.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.1.0",
    "typescript": "~6.0.2",
    "vitest": "^4.1.10"
  }
}
