{
  "name": "@pollium/readable-contracts",
  "version": "0.0.0",
  "description": "The routes, envelopes and error tables a Readable API and its web app share.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pollium/Readable.git",
    "directory": "packages/contracts"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./*": "./src/*.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      "./*": {
        "types": "./dist/*.d.ts",
        "default": "./dist/*.js"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "lint": "oxlint --deny-warnings",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2"
  }
}
